# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Gmail IMAP (App Password — NOT your regular Gmail password)
# See: https://myaccount.google.com/apppasswords
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx


# Webhook / cron secret (protects the check-email and wpform endpoints)
WEBHOOK_SECRET=change-me-to-a-random-string

# Base URL for client result links (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
